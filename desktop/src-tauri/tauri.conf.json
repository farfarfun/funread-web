{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "funread-light",
  "mainBinaryName": "funread-light",
  "version": "../../package.json",
  "identifier": "com.farfarfun.funread.light",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "farfarfun",
    "homepage": "https://github.com/farfarfun/funread-web",
    "category": "Education",
    "license": "MIT",
    "shortDescription": "funread light：打开你自己那台 funread 服务器",
    "longDescription": "funread 是自托管的，没有官方服务器。funread light 不打包任何 Web 资源，启动时问你服务器地址，然后把整个窗口交给那台服务器上的页面 —— 登录态、离线缓存都和在浏览器里打开同一个地址完全一样。",
    "linux": {
      "deb": {
        "section": "web",
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
