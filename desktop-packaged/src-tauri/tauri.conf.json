{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "funread",
  "mainBinaryName": "funread",
  "version": "../../package.json",
  "identifier": "com.farfarfun.funread",
  "build": {
    "frontendDist": "../../dist-packaged"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "farfarfun",
    "homepage": "https://github.com/farfarfun/funread-web",
    "category": "Education",
    "license": "MIT",
    "shortDescription": "funread：自托管的小说与订阅阅读客户端",
    "longDescription": "funread 是自托管的，没有官方服务器。这一版把 Web 资源打进了应用，启动不用网络；第一次打开时填你自己那台服务器的地址和账号，客户端会换一条可随时吊销的设备 token 存在本机。",
    "linux": {
      "deb": {
        "section": "web",
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
